# Server
PORT=5000
NODE_ENV=development

# Database (Railway provides this automatically when you add a PostgreSQL plugin)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ado_palmwinery

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Tilo Pay API
TILO_PAY_API_KEY=your-tilo-pay-api-key
TILO_PAY_SECRET_KEY=your-tilo-pay-secret-key
TILO_PAY_BASE_URL=https://api.tilopay.com/v1
TILO_PAY_WEBHOOK_SECRET=your-tilo-pay-webhook-secret

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Geolocation API (for language/currency detection)
GEOIP_API_KEY=your-geoip-api-key
