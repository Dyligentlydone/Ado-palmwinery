# Server
PORT=5000
NODE_ENV=development

# Database (Railway provides this automatically when you add a PostgreSQL plugin)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ado_palmwinery

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ONVO Pay (keys from the ONVO dashboard — onvo_test_* / onvo_live_*)
ONVO_SECRET_KEY=onvo_test_secret_key_xxx
# Webhook secret shown next to your webhook URL in the dashboard (webhook_secret_*)
ONVO_WEBHOOK_SECRET=webhook_secret_xxx
ONVO_BASE_URL=https://api.onvopay.com

# Frontend URL (for CORS + payment redirect/cancel URLs)
CLIENT_URL=http://localhost:5173

# Geolocation API (for language/currency detection)
GEOIP_API_KEY=your-geoip-api-key
